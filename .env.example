# Copy to .env and fill locally. Never share or commit real keys.
TRADEMIND_DEEPSEEK_API_KEY=
TRADEMIND_JEV_API_KEY=
# LLM wire protocol: openai_chat (DeepSeek official, default) |
# anthropic_messages | openai_responses | gemini_generate_content.
TRADEMIND_LLM_PROTOCOL=
# JEV: the official TypeSafe adapter (provider="jev_typesafe") is implemented
# and certified; provider="stub" remains only for offline V1/replay isolation.
# Keys and service URLs can also be managed from the workbench admin page
# (requires TRADEMIND_API_TOKEN); see docs/architecture/24-admin-runtime-settings.md.
